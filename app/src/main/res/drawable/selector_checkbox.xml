<!-- res/drawable/selector_checkbox.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <stroke android:width="1dp" android:color="@color/color_primary"/>
                    <solid android:color="@color/white"/>
                    <corners android:radius="4dp"/>
                </shape>
            </item>
            <item
                android:width="24dp"
                android:height="24dp"
                android:gravity="center">
                <vector
                    android:width="24dp"
                    android:height="24dp"
                    android:viewportWidth="24"
                    android:viewportHeight="24">
                    <group
                        android:pivotX="12"
                        android:pivotY="12"
                        android:scaleX="0.8"
                        android:scaleY="0.8">
                        <path
                            android:fillColor="@color/color_primary"
                            android:pathData="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"/>
                    </group>
                </vector>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/gray"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</selector>