<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 색깔 배경 -->
    <solid android:color="@color/color_primary" />

    <!-- 회색 테두리 -->
    <stroke
        android:width="1dp"
        android:color="#888888" />

    <!-- 둥근 모서리 -->
    <corners android:radius="8dp" />

    <!-- 텍스트와의 간격 -->
    <padding
        android:bottom="4dp"
        android:left="8dp"
        android:right="8dp"
        android:top="4dp" />
</shape>
