<!-- res/drawable/bg_agree_button.xml -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_primary"/> <!-- 활성화 색상 -->
            <corners android:radius="8dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/gray_light"/> <!-- 비활성화 색상 -->
            <corners android:radius="8dp"/>
        </shape>
    </item>
</selector>
