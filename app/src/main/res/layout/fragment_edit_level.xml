<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_buttons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/my_page_back"
            android:layout_marginStart="32dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageView
            android:id="@+id/etc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/menu"
            android:layout_marginEnd="27dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/top_buttons"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="43dp"
        android:layout_marginStart="32dp"
        android:text="난이도 변경"
        android:textColor="#2E2E2E"
        android:textSize="24sp"
        android:fontFamily="@font/pretendard_bold" />

    <TextView
        android:id="@+id/warning_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/header_title"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:layout_marginStart="32dp"
        android:text="지나친 자신감은 금물이에요!\n전문가와 상담 후 변경을 추천드려요."
        android:textColor="#2E2E2E"
        android:textSize="20sp"
        android:fontFamily="@font/pretendard_medium" />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintTop_toTopOf="@id/difficultySlider"
        android:layout_marginTop="10dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:background="#F0F0F0"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/difficultySlider"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/warning_text"
        app:layout_constraintBottom_toTopOf="@+id/additional_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="100dp"
        android:paddingTop="10dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:elevation="8dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="@id/difficultySlider"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="44dp"
        android:layout_marginEnd="44dp"
        android:background="#F0F0F0"/>
    <TextView
        android:id="@+id/additional_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="한 단계 변경시\n운동 강도가 약 30% 증가해요"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textAlignment="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cancel_button"
        android:layout_marginBottom="95dp"
        />

    <TextView
        android:id="@+id/cancel_button"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/save_button"
        android:layout_marginBottom="128dp"
        android:layout_marginStart="29dp"
        android:layout_marginEnd="7dp"
        android:background="@drawable/edit_profile_button"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:text="취소"
        android:textColor="#606060"
        android:textSize="16sp"/>

    <TextView
        android:id="@+id/save_button"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cancel_button"
        android:layout_marginBottom="128dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="29dp"
        android:background="@drawable/edit_profile_button"
        android:backgroundTint="#2E2E2E"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:text="저장하기"
        android:textColor="#F8F8F8"
        android:textSize="16sp"/>

</androidx.constraintlayout.widget.ConstraintLayout>