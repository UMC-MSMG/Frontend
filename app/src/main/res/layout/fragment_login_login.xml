<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgSplash"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/icon"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="만수무강"
        android:textSize="30sp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/imgSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- 카카오 로그인 버튼 -->

    <TextView
        android:id="@+id/phone_tv"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="전화번호를 입력하세요"
        android:layout_marginTop="60dp"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        android:layout_marginStart="50dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tvSplash" />
    
    <EditText
        android:paddingStart="15dp"
        android:singleLine="true"
        android:id="@+id/et_1"
        android:layout_width="306dp"
        android:layout_height="36dp"
        app:layout_constraintTop_toBottomOf="@id/phone_tv"
        android:hint="   -없이 입력해주세요"
        android:textSize="16sp"
        android:background="@drawable/round_corner_light_gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <TextView
        android:id="@+id/verify_tv"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="인증번호를 입력해주세요"
        android:layout_marginTop="40dp"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        android:layout_marginStart="50dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/et_1" />

    <EditText
        android:paddingStart="15dp"
        android:singleLine="true"
        android:clickable="false"
        android:id="@+id/et_2"
        android:layout_width="306dp"
        android:layout_height="36dp"
        app:layout_constraintTop_toBottomOf="@id/verify_tv"
        android:hint=""
        android:textSize="16sp"
        android:background="@drawable/round_corner_light_gray"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="10dp"/>

    <TextView
        android:elevation="3dp"
        android:id="@+id/verify_btn"
        app:layout_constraintEnd_toEndOf="@id/et_1"
        app:layout_constraintTop_toTopOf="@id/et_1"
        app:layout_constraintBottom_toBottomOf="@id/et_1"
        android:layout_marginEnd="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="인증"
        android:textSize="18dp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="@color/black"
         />

    <TextView
        android:fontFamily="@font/pretendard_bold"
        android:id="@+id/btn_login"
        android:layout_width="257dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:background="@drawable/round_corner_light_gray"
        android:backgroundTint="@color/color_primary"
        android:text="로그인 하기"
        android:textSize="18sp"
        android:layout_marginBottom="50dp"
        android:layout_marginTop="120dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:visibility="gone"
        android:id="@+id/verify_alarm2"
        app:layout_constraintTop_toBottomOf="@id/et_2"
        app:layout_constraintStart_toStartOf="@id/verify_tv"
        android:layout_marginEnd="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="인증번호가 일치하지 않습니다"
        android:layout_marginTop="5dp"
        android:textSize="16dp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="#F05605"
        />

    <TextView
        android:visibility="gone"
        android:id="@+id/verify_alarm1"
        app:layout_constraintTop_toBottomOf="@id/et_1"
        app:layout_constraintStart_toStartOf="@id/verify_tv"
        android:layout_marginEnd="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="등록되지 않은 전화번호입니다"
        android:layout_marginTop="5dp"
        android:textSize="16dp"
        android:fontFamily="@font/pretendard_medium"
        android:textColor="#F05605"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
