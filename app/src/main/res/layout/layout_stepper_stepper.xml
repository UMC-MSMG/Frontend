<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_secondary"
    android:focusable="true"
    android:clickable="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_secondary"
            android:focusable="true"
            android:clickable="true">

    <FrameLayout
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/map_frame"
        android:layout_width="330dp"
        android:layout_height="440dp"
        android:layout_marginTop="70dp"
        android:src="@color/color_background" />

    <ImageView
        android:visibility="gone"
        android:elevation="3dp"
        android:clickable="false"
        android:id="@+id/arrived"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@+id/map_frame"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@color/color_primary"
        />

            <TextView
                android:visibility="gone"
                android:id="@+id/arrived_tv_1"
                android:elevation="10dp"
                app:layout_constraintBottom_toTopOf="@id/arrived_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="목적지에 도착했어요"
                android:gravity="center"
                android:textColor="@color/black"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="36sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

            <TextView
                android:visibility="gone"
                android:id="@+id/arrived_tv"
                android:elevation="10dp"
                app:layout_constraintTop_toTopOf="@id/bg"
                android:layout_marginTop="85dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="10원 적립 성공!\n내일도 도전해보세요"
                android:gravity="center"
                android:textColor="@color/black"
                android:fontFamily="@font/pretendard_bold"
                android:textSize="24sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />
    <ImageView
        android:id="@+id/bg"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        app:layout_constraintTop_toBottomOf="@+id/map_frame"
        android:layout_marginTop="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@color/color_background"
        />

    <TextView
        android:id="@+id/dest_tv"
        app:layout_constraintTop_toTopOf="@id/bg"
        android:layout_marginTop="24dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="평촌중앙공원 놀이터에 가면"
        android:gravity="center"

        android:textColor="@color/black"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <TextView
        app:layout_constraintTop_toTopOf="@id/bg"
        android:layout_marginTop="65dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10원 지급"
        android:textColor="@color/black"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="36sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <ImageView
        android:id="@+id/btn"
        android:layout_width="150dp"
        android:layout_height="50dp"
        app:layout_constraintTop_toBottomOf="@id/bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="-70dp"
        android:paddingBottom="50dp"
        android:background="@drawable/round_corner_primary"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="다시 고르기"
        android:textColor="@color/black"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintStart_toStartOf="@id/btn"
        app:layout_constraintEnd_toEndOf="@id/btn"
        app:layout_constraintTop_toTopOf="@id/btn"
        app:layout_constraintBottom_toBottomOf="@id/btn"
        android:textSize="18sp"
        />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>