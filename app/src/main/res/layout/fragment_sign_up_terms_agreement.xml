<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <!-- 약관동의 헤더 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="약관동의"
        android:textSize="28sp"
        android:textColor="@color/black"
        android:fontFamily="@font/pretendard_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- 전체 동의 버튼 -->
    <TextView
        android:id="@+id/tv_agree_all"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="네, 모두 동의합니다."
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_medium"
        android:gravity="center"
        android:background="@drawable/agree_button"
        app:layout_constraintTop_toBottomOf="@id/tv_title"/>

    <!-- 개인정보 동의 -->
    <TextView
        android:id="@+id/tv_agree_required"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="개인정보 활용동의 (필수)"
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_medium"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/selector_checkbox"
        app:layout_constraintTop_toBottomOf="@id/tv_agree_all"/>

    <!-- 제3자 동의 -->
    <TextView
        android:id="@+id/tv_agree_optional"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="제3자 활용동의 (선택)"
        android:textSize="18sp"
        android:fontFamily="@font/pretendard_medium"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:drawableStart="@drawable/selector_checkbox"
        app:layout_constraintTop_toBottomOf="@id/tv_agree_required"/>

    <!-- 약관 내용 -->
    <TextView
        android:id="@+id/tv_terms_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="@string/terms_content"
        android:textSize="18sp"
        android:textColor="@color/black"
        android:fontFamily="@font/pretendard_medium"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/tv_agree_optional"
        app:layout_constraintBottom_toTopOf="@id/btn_confirm"/>

    <!-- 동의하기 버튼 -->
    <TextView
        android:id="@+id/btn_confirm"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="다음"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:fontFamily="@font/pretendard_medium"
        android:background="@drawable/rounded_button"
        android:backgroundTint="@color/color_primary"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
