<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <ImageView
        android:id="@+id/imgSplash"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/icon"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="만수무강"
        android:textSize="30sp"
        android:fontFamily="@font/pretendard_bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/imgSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <!-- 카카오 로그인 버튼 -->

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/kakao"
        app:layout_constraintStart_toStartOf="@id/btn_kakao_login"
        app:layout_constraintTop_toTopOf="@id/btn_kakao_login"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="@id/btn_kakao_login"
        android:layout_marginStart="35dp"/>
    <TextView
        app:layout_constraintTop_toBottomOf="@id/btn_login"
        android:paddingStart="40dp"
        android:fontFamily="@font/pretendard_bold"
        android:id="@+id/btn_kakao_login"
        android:layout_width="232dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:background="@drawable/round_corner_kakao"
        android:backgroundTint="@color/kakao_bg"
        android:text="카카오로 시작하기"
        android:textSize="18sp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:fontFamily="@font/pretendard_bold"
        android:id="@+id/btn_login"
        android:layout_width="232dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:background="@drawable/round_corner_light_gray"
        android:backgroundTint="#D9D9D9"
        android:text="전화번호 로그인"
        android:textSize="18sp"
        android:layout_marginTop="120dp"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@id/tvSplash"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <TextView
        android:fontFamily="@font/pretendard_medium"
        android:id="@+id/desrciption_tv"
        android:layout_width="257dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:text="처음이시라면?"
        android:textSize="14sp"
        android:layout_marginBottom="85dp"
        android:textColor="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:fontFamily="@font/pretendard_bold"
        android:id="@+id/btn_register"
        android:layout_width="257dp"
        android:layout_height="42dp"
        android:gravity="center"
        android:background="@drawable/round_corner_light_gray"
        android:backgroundTint="@color/color_primary"
        android:text="회원가입 하기"
        android:textSize="18sp"
        android:layout_marginBottom="50dp"
        android:layout_marginTop="120dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />



</androidx.constraintlayout.widget.ConstraintLayout>
