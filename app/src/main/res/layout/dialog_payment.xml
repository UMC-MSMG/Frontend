<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_box">

    <ImageView
        android:id="@+id/itemImage"
        android:layout_width="60dp"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="42dp"
        android:src="@drawable/icon" />

    <ImageView
        android:id="@+id/dash1"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/itemImage"
        android:layout_marginTop="34dp"
        android:layout_marginStart="82dp"
        android:layout_marginEnd="82dp"
        android:src="@drawable/dialog_dash"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/dash1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"
        android:text="@string/app_name"
        android:textSize="24sp"
        android:textColor="@color/black"
        android:fontFamily="@font/pretendard_medium"
        android:gravity="center"/>

    <ImageView
        android:id="@+id/dash2"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        android:layout_marginTop="24dp"
        android:layout_marginStart="82dp"
        android:layout_marginEnd="82dp"
        android:src="@drawable/dialog_dash"/>

    <TextView
        android:id="@+id/confirmButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/dash2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        android:layout_marginTop="58dp"
        android:text="결제하기"
        android:textSize="20sp"
        android:textColor="#606060"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:background="@drawable/payment_dialog_accept"/>

    <TextView
        android:id="@+id/cancelButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/confirmButton"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="49dp"
        android:layout_marginEnd="49dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="27dp"
        android:text="취소"
        android:textSize="20sp"
        android:textColor="#606060"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:background="@drawable/payment_dialog_cancel"/>
</androidx.constraintlayout.widget.ConstraintLayout>
