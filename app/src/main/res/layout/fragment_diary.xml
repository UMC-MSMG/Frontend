<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/back_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintVertical_bias="0.4"
        android:layout_marginStart="31dp"
        android:elevation="16dp"
        android:src="@drawable/back_button" />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="55dp"
                android:layout_marginTop="70dp"
                android:layout_marginStart="29dp"
                android:text="내 운동일지"
                android:textSize="20sp"
                android:gravity="center_vertical"
                android:textColor="@color/black"
                android:fontFamily="@font/pretendard_bold" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/diary_box"
                android:layout_marginStart="33dp"
                android:layout_marginEnd="33dp"
                android:elevation="8dp">

                <LinearLayout
                    android:id="@+id/dateHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/todayDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="09 / 05 / 1992"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/pretendard_light"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/calendar" />
                </LinearLayout>

                <View
                    android:id="@+id/line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="1dp"
                    android:layout_marginEnd="1dp"
                    app:layout_constraintTop_toBottomOf="@id/dateHeader"
                    android:background="#F0F0F0"/>

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.MaterialCalendar"
                    app:layout_constraintTop_toBottomOf="@id/line"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/calendarView"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginBottom="19dp"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/exerciseDaysText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="7dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/diary_button"
                        android:backgroundTint="#EEF1F4"
                        android:padding="3dp"
                        android:text="운동 일수\n3일"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="#545F71"
                        android:fontFamily="@font/pretendard_bold"/>

                    <TextView
                        android:id="@+id/pointsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="7dp"
                        android:padding="3dp"
                        android:text="번 돈\n25원"
                        android:background="@drawable/diary_button"
                        android:backgroundTint="#545F71"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/pretendard_bold" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:layout_marginStart="35dp"
                android:layout_marginEnd="55dp">
                <TextView
                    android:id="@+id/totalPointsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="3dp"
                    android:layout_marginStart="2dp"
                    android:text="총 25원 모았어요."
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/pretendard_bold"
                    android:gravity="center_horizontal" />
                <TextView
                    android:id="@+id/increasedPointsText1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/totalPointsText"
                    android:text="저번 달보다"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal"
                    android:fontFamily="@font/pretendard_medium"/>
                <TextView
                    android:id="@+id/increasedPointsText2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/increasedPointsText1"
                    android:text="25원 더 모았어요."
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal"
                    android:fontFamily="@font/pretendard_medium"/>
                <ImageView
                    android:id="@+id/statisticsGraphImageView"
                    android:layout_width="121dp"
                    android:layout_height="45dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:srcCompat="@drawable/graph" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/diary_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/diary_box"
                android:elevation="8dp"
                android:padding="17dp">
                <TextView
                    android:id="@+id/consecutiveDaysText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginStart="1dp"
                    android:text="3일 연속 운동했어요."
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/pretendard_bold"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="매우 좋은 습관이에요."
                    app:layout_constraintTop_toBottomOf="@id/consecutiveDaysText"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal"
                    android:fontFamily="@font/pretendard_medium"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="4dp"
                    android:layout_marginEnd="10dp"
                    android:text="운동일지\n바로가기"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:fontFamily="@font/pretendard_medium" />
            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/shop_button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="27dp"
        android:layout_marginEnd="27dp"
        android:layout_marginBottom="24dp"
        android:text="만수무강 상점 바로가기"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center_horizontal|center_vertical"
        android:background="@drawable/point_button" />
</androidx.constraintlayout.widget.ConstraintLayout>
