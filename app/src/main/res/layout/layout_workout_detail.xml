<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_background"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/a1_top_tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="100dp"
        android:fontFamily="@font/pretendard_bold"
        android:paddingBottom="5dp"
        android:text="근력 운동하기"
        android:textColor="@color/black"
        android:textSize="36sp" />

    <TextView
        android:id="@+id/name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="@id/bg"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="40dp"
        android:layout_marginStart="30dp"
        android:fontFamily="@font/pretendard_bold"
        android:paddingBottom="5dp"
        android:text="오늘의 근력운동이에요."
        android:textColor="@color/black"
        android:textSize="28sp" />


<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:id="@+id/content"
    app:layout_constraintTop_toBottomOf="@id/name_tv"
    app:layout_constraintStart_toStartOf="parent"
    android:layout_marginTop="40dp"
    android:layout_marginStart="50dp"
    android:fontFamily="@font/pretendard_medium"
    android:paddingBottom="5dp"
    android:text="어쩌구 \n어쩌구 \n어쩌구 \n어쩌구"
    android:textColor="@color/black"
    android:textSize="24sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btn_start_tv"
        app:layout_constraintStart_toStartOf="@id/start_btn"
        app:layout_constraintEnd_toEndOf="@id/start_btn"
        app:layout_constraintTop_toTopOf="@id/start_btn"
        app:layout_constraintBottom_toBottomOf="@id/start_btn"
        android:elevation="2dp"
        android:fontFamily="@font/pretendard_bold"
        android:paddingBottom="5dp"
        android:text="근력 운동 시작하기"
        android:textColor="@color/black"
        android:textSize="20sp" />


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/btn_change_tv"
        app:layout_constraintStart_toStartOf="@id/change_btn"
        app:layout_constraintEnd_toEndOf="@id/change_btn"
        app:layout_constraintTop_toTopOf="@id/change_btn"
        app:layout_constraintBottom_toBottomOf="@id/change_btn"
        android:elevation="2dp"
        android:fontFamily="@font/pretendard_bold"
        android:paddingBottom="5dp"
        android:text="다른 운동 시작하기"
        android:textColor="#808080"
        android:textSize="20sp" />

    <ImageView
        android:id="@+id/start_btn"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:src="@color/color_primary"
        android:layout_marginBottom="140dp"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@drawable/round_corner_primary"/>

    <ImageView
        android:id="@+id/change_btn"
        android:layout_width="300dp"
        android:layout_height="60dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="15dp"
        android:src="@color/white"
        app:layout_constraintTop_toBottomOf="@id/start_btn"
        android:background="@drawable/round_corner_white"/>

    <ImageView
        android:elevation="-1dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/a1_top_tv1"
        android:id="@+id/bg"
        android:layout_width="412dp"
        android:layout_height="900dp"
        android:layout_marginTop="60dp"
        android:background="@drawable/round_corner_secondary"
        android:src="#F8F8F8" />

</androidx.constraintlayout.widget.ConstraintLayout>
