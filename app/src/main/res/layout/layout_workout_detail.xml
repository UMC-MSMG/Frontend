<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/color_background">

    <TextView
        android:id="@+id/a1_top_tv1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp"
        android:elevation="31dp"
        android:fontFamily="@font/pretendard_bold"
        android:paddingBottom="5dp"
        android:text="유산소 운동하기"
        android:textColor="@color/black"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/name_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/a1_top_tv1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="70dp"
        android:elevation="31dp"
        android:fontFamily="@font/pretendard_bold"
        android:paddingBottom="5dp"
        android:text="오늘의 루틴"
        android:textColor="@color/black"
        android:textSize="24sp" />






    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/name_tv"
        android:id="@+id/area_3"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/round_corner_secondary"
        android:elevation="15dp"
        android:src="@color/color_secondary" />

    <TextView
        android:id="@+id/a4_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="31dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="제자리 걷기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/area_4"
        app:layout_constraintTop_toTopOf="@id/area_4"
        app:layout_constraintStart_toStartOf="@id/area_4"
        app:layout_constraintEnd_toEndOf="@+id/area_4"/>


    <TextView
        android:id="@+id/a3_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="31dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="제자리 걷기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/area_3"
        app:layout_constraintTop_toTopOf="@id/area_3"
        app:layout_constraintStart_toStartOf="@id/area_3"
        app:layout_constraintEnd_toEndOf="@+id/area_3"/>

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/area_3"

        android:id="@+id/area_4"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/round_corner_secondary"
        android:elevation="15dp"
        android:src="@color/color_secondary" />



    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/area_4"

        android:id="@+id/area_5"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/round_corner_secondary"
        android:elevation="15dp"
        android:src="@color/color_secondary" />

    <TextView
        android:id="@+id/a5_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="31dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="제자리 걷기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/area_5"
        app:layout_constraintTop_toTopOf="@id/area_5"
        app:layout_constraintStart_toStartOf="@id/area_5"
        app:layout_constraintEnd_toEndOf="@+id/area_5"/>

    <TextView
        android:id="@+id/a6_left_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="31dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="제자리 걷기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="@id/area_6"
        app:layout_constraintTop_toTopOf="@id/area_6"
        app:layout_constraintStart_toStartOf="@id/area_6"
        app:layout_constraintEnd_toEndOf="@+id/area_6"/>

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/area_5"

        android:id="@+id/area_6"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/round_corner_secondary"
        android:elevation="15dp"
        android:src="@color/color_secondary" />



    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/a1_top_tv1"
        android:id="@+id/bg"
        android:layout_width="412dp"
        android:layout_height="900dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/round_corner_secondary"
        android:src="#F8F8F8" />




</androidx.constraintlayout.widget.ConstraintLayout>
