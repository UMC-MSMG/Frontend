<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="41dp"
                android:background="@drawable/diary_box"
                android:elevation="8dp"
                android:padding="14dp">

                <LinearLayout
                    android:id="@+id/dateHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="11dp"
                    android:padding="12dp">
                    <TextView
                        android:id="@+id/todayDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="09 / 05 / 1992"
                        android:textSize="16sp"
                        android:textColor="@color/black" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/calendar" />
                </LinearLayout>
                <View
                    android:id="@+id/line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    app:layout_constraintTop_toBottomOf="@id/dateHeader"
                    android:background="#F0F0F0"/>

                <CalendarView
                    android:id="@+id/calendarView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/line"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/calendarView"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/exerciseDaysText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="3일"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/pointsText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="25원"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        android:textColor="@color/black" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/diary_box"
                android:layout_marginTop="41dp"
                android:elevation="8dp"
                android:padding="32dp">
                <TextView
                    android:id="@+id/totalPointsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="9dp"
                    android:text="총 25점 모았어요."
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal" />
                <TextView
                    android:id="@+id/increasedPointsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@id/totalPointsText"
                    android:text="지난 달보다 25원 더 모았어요."
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal" />
                <ImageView
                    android:id="@+id/statisticsGraphImageView"
                    android:layout_width="163dp"
                    android:layout_height="108dp"
                    app:layout_constraintTop_toBottomOf="@id/increasedPointsText"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="31dp"
                    app:srcCompat="@drawable/graph" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="41dp"
                android:background="@drawable/diary_box"
                android:elevation="8dp"
                android:padding="32dp">
                <TextView
                    android:id="@+id/consecutiveDaysText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3일 연속 운동했어요."
                    android:textSize="20sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="매우 좋은 습관이에요."
                    app:layout_constraintTop_toBottomOf="@id/consecutiveDaysText"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center_horizontal" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <TextView
                android:id="@+id/shop_button"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:text="만수무강 상점 바로가기"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:gravity="center_horizontal|center_vertical"
                android:background="@drawable/point_button"
                android:elevation="8dp"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
