<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/area_1"
        android:layout_width="372dp"
        android:layout_height="117dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="70dp"
        android:background="@drawable/round_corner_primary"

        android:src="@color/color_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/a2_top_tv1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/area_1"
            android:text="내 포인트"
            android:layout_marginTop="10dp"
            android:textSize="26sp"
            android:textColor="@color/white"
            />

        <TextView
            android:id="@+id/a2_mid_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="25 원"
            android:textColor="@color/white"
            android:textSize="36sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/a2_top_tv1" />

    <ImageView
        android:elevation="-1dp"
        android:id="@+id/background"
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:layout_marginTop="160dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:background="@drawable/round_corner_secondary"
        />

    <TextView
        android:id="@+id/money_spend_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="포인트 쓰러 가기 >"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/a2_mid_tv"
        android:layout_marginTop="30dp"/>


    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/area_1"

        android:id="@+id/bg_1"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="90dp"
        android:background="@drawable/round_corner_white"
        android:src="@color/color_secondary" />

        <TextView
            android:id="@+id/bg_1_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="내 근처 방문하기"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@id/area_1"
            app:layout_constraintTop_toTopOf="@id/bg_1"
            app:layout_constraintBottom_toBottomOf="@id/bg_1"
            android:layout_marginStart="30dp"
            />

    <TextView
        android:id="@+id/bg_1_tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="100원 받기 >"
        android:textColor="#707070"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/area_1"
        app:layout_constraintTop_toTopOf="@id/bg_1"
        app:layout_constraintBottom_toBottomOf="@id/bg_1"
        android:layout_marginEnd="30dp"
        />

    <TextView
        android:id="@+id/bg_4_tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="1/2일 >"
        android:textColor="#707070"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/bg_4"
        app:layout_constraintTop_toTopOf="@id/bg_4"
        app:layout_constraintBottom_toBottomOf="@id/bg_4"
        android:layout_marginEnd="30dp"
        android:elevation="1dp"
        />

    <TextView
        android:id="@+id/bg_2_tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="5원 받기 >"
        android:textColor="#707070"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/bg_2"
        app:layout_constraintTop_toTopOf="@id/bg_2"
        app:layout_constraintBottom_toBottomOf="@id/bg_2"
        android:layout_marginEnd="30dp"
        />

    <TextView
        android:id="@+id/bg_3_tv2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_regular"
        android:text="10원 받기 >"
        android:textColor="#707070"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="@id/bg_3"
        app:layout_constraintTop_toTopOf="@id/bg_3"
        app:layout_constraintBottom_toBottomOf="@id/bg_3"
        android:layout_marginEnd="30dp"
        android:elevation="1dp"
        />

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bg_1"
        android:elevation="-1dp"
        android:id="@+id/bg_2"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/round_corner_white"
        android:src="@color/color_secondary" />

        <TextView
        android:id="@+id/bg_2_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="500걸음 걷기"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@id/bg_2"
            app:layout_constraintTop_toTopOf="@id/bg_2"
            app:layout_constraintBottom_toBottomOf="@id/bg_2"
            android:layout_marginStart="30dp"
        />

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bg_2"

        android:id="@+id/bg_3"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/round_corner_white"
        android:src="@color/color_secondary" />

    <TextView
        android:id="@+id/bg_3_tv"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:text="1000걸음 걷기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/bg_3"
        app:layout_constraintTop_toTopOf="@id/bg_3"
        app:layout_constraintBottom_toBottomOf="@id/bg_3"
        android:layout_marginStart="30dp"
        />

    <ImageView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/bg_3"

        android:id="@+id/bg_4"
        android:layout_width="372dp"
        android:layout_height="67dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/round_corner_white"
        android:src="@color/color_secondary" />

    <TextView
        android:id="@+id/bg_4_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pretendard_bold"
        android:text="운동 2일 연속 완료하기"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintStart_toStartOf="@id/bg_4"
        app:layout_constraintTop_toTopOf="@id/bg_4"
        app:layout_constraintBottom_toBottomOf="@id/bg_4"
        android:layout_marginStart="30dp"
        />


</androidx.constraintlayout.widget.ConstraintLayout>