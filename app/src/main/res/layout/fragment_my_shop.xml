<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="15dp"
        android:layout_height="28dp"
        android:src="@drawable/back_button"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="56dp"
        android:layout_marginStart="33dp"/>

    <ImageView
        android:id="@+id/etc"
        android:layout_width="31dp"
        android:layout_height="24dp"
        android:src="@drawable/setting"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginEnd="27dp"
        android:layout_marginTop="56dp"/>

    <TextView
        android:id="@+id/header_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        android:text="내 상점"
        android:fontFamily="@font/pretendard_bold"
        android:textSize="24sp"
        android:textColor="#2E2E2E" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/point_box"
        android:layout_width="372dp"
        android:layout_height="98dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="177dp"
        android:background="@drawable/shop_box">


        <TextView
            android:id="@+id/pointsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="내 포인트"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <LinearLayout
            android:id="@+id/point_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/pointsText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/coin"
                android:layout_gravity="center"/>

            <TextView
                android:id="@+id/my_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:fontFamily="@font/pretendard_bold"
                android:text="25"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/pretendard_medium"
                android:text="원"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:layout_gravity="center"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/total_used_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="285.65dp"
        android:fontFamily="@font/pretendard_medium"
        android:text="누적 사용 포인트 1025원"
        android:textColor="#606060"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/bottom_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/round_corner_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/point_box"
        android:layout_marginTop="50dp"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="@id/bottom_background">

        <ImageView
            android:id="@+id/item1_image"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:src="@drawable/icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/item1_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="레쓰비"
            android:textColor="#2E2E2E"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@id/item1_image"
            app:layout_constraintTop_toTopOf="@id/item1_image" />

        <TextView
            android:id="@+id/item1_office"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="GS25"
            android:textColor="#606060"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@id/item1_name"
            app:layout_constraintTop_toBottomOf="@id/item1_name" />

        <TextView
            android:id="@+id/item1_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="800원"
            android:textColor="#2E2E2E"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/item1_image"
            app:layout_constraintStart_toStartOf="@id/item1_name"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/item1_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="사용하기"
            android:textColor="#2E2E2E"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/item1_price"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="20dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/divider1"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/item2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/divider1">

        <ImageView
            android:id="@+id/item2_image"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:src="@drawable/icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/item2_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="0dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="좀비싼커피"
            android:textColor="#2E2E2E"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@id/item2_image"
            app:layout_constraintTop_toTopOf="@id/item2_image" />

        <TextView
            android:id="@+id/item2_office"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/pretendard_medium"
            android:text="CU"
            android:textColor="#606060"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="@id/item2_name"
            app:layout_constraintTop_toBottomOf="@id/item2_name" />

        <TextView
            android:id="@+id/item2_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_bold"
            android:text="3000원"
            android:textColor="#2E2E2E"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/item2_image"
            app:layout_constraintStart_toStartOf="@id/item2_name"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:id="@+id/item2_use"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/pretendard_medium"
            android:text="사용완료"
            android:textColor="#FF494C"
            android:textSize="20sp"
            app:layout_constraintBottom_toBottomOf="@id/item2_price"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginEnd="20dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/divider2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/item2"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>


    <TextView
        android:id="@+id/cancel_button"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_marginStart="28dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/edit_profile_button"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:text="취소"
        android:textColor="#606060"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/shop_button"
        android:layout_width="170dp"
        android:layout_height="48dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="36dp"
        android:background="@drawable/edit_profile_button"
        android:fontFamily="@font/pretendard_bold"
        android:gravity="center"
        android:text="상점 바로가기"
        android:backgroundTint="#6DD099"
        android:textColor="#2E2E2E"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>