<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/combined_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgSplash"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="120dp"
            android:src="@drawable/icon"
            android:layout_marginBottom="15dp" />
    </LinearLayout>

    <!-- 1. 이름 입력 -->
    <LinearLayout
        android:visibility="visible"
        android:id="@+id/layoutName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:fontFamily="@font/pretendard_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이름을 입력해주세요"
            android:textSize="18sp"/>

        <EditText
            android:fontFamily="@font/pretendard_medium"
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingVertical="10dp"
            android:hint="이름"
            android:inputType="textPersonName"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- 2. 성별 입력 -->
    <LinearLayout
        android:id="@+id/layoutGender"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:fontFamily="@font/pretendard_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="성별을 선택해주세요"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <RadioGroup
            android:id="@+id/rgGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <RadioButton
                android:fontFamily="@font/pretendard_medium"
                android:id="@+id/rbMale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="남성"/>

            <RadioButton
                android:fontFamily="@font/pretendard_medium"
                android:id="@+id/rbFemale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="여성"
                android:layout_marginStart="16dp"/>
        </RadioGroup>
    </LinearLayout>

    <!-- 3. 생년월일 입력 -->
    <LinearLayout
        android:id="@+id/layoutBirthdate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:fontFamily="@font/pretendard_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="생년월일을 입력해주세요"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <DatePicker
            android:id="@+id/dpBirthdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:datePickerMode="spinner"
            android:calendarViewShown="false"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!-- 4. 전화번호 입력 -->
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/layoutPhone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:fontFamily="@font/pretendard_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="전화번호를 입력해주세요"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:fontFamily="@font/pretendard_medium"
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingVertical="10dp"
            android:hint="01000000000"
            android:inputType="phone"
            android:layout_marginTop="8dp"/>
    </LinearLayout>

    <!--인증 버튼-->
    <LinearLayout
        android:visibility="gone"
        android:id="@+id/layoutVerify"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:fontFamily="@font/pretendard_bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="인증번호를 입력해주세요"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <EditText
            android:fontFamily="@font/pretendard_medium"
            android:id="@+id/etVerify"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:paddingVertical="10dp"
            android:inputType="phone"
            android:layout_marginTop="8dp"/>

        <TextView
            android:id="@+id/tvWrong"
            android:visibility="gone"
            android:textColor="#F05605"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text = "인증번호가 일치하지 않습니다"/>
    </LinearLayout>

    <!-- 다음 버튼 -->

    <TextView
        android:id="@+id/tvNext"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="다음"
        android:textSize="24sp"
        android:textColor="@color/white"
        android:fontFamily="@font/pretendard_medium"
        android:background="@drawable/round_corner_primary"
        android:backgroundTint="@color/color_primary"
        android:gravity="center"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
