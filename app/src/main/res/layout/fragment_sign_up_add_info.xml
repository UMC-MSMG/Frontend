<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- icon -->
    <LinearLayout
        android:id="@+id/combined_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/icon"
            android:layout_marginBottom="15dp" />
        <TextView
            android:id="@+id/tvSplash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="만수무강"
            android:textSize="30sp"
            android:fontFamily="@font/pretendard_bold"
            android:textColor="@color/black" />
    </LinearLayout>

    <!-- 키 입력 -->
    <LinearLayout
        android:id="@+id/layoutHeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="당신의 키를 알려주세요 (cm)"
            android:textSize="20sp"
            android:fontFamily="@font/pretendard_bold"/>

        <NumberPicker
            android:id="@+id/npHeight"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- 몸무게 입력 -->
    <LinearLayout
        android:id="@+id/layoutWeight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="당신의 몸무게를 알려주세요 (kg)"
            android:textSize="20sp"
            android:fontFamily="@font/pretendard_medium"/>

        <NumberPicker
            android:id="@+id/npWeight"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"/>

    </LinearLayout>

    <!-- 복용 약물 존재 여부 -->
    <LinearLayout
        android:id="@+id/layoutMedicineExist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="현재 복용중인 약이 있나요?"
            android:textSize="20sp"
            android:textAlignment="center"
            android:fontFamily="@font/pretendard_medium"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/btn_yes"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="예"
                android:gravity="center"
                android:background="@drawable/rounded_button"
                android:backgroundTint="@color/color_background"
                android:textColor="@color/black"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/btn_no"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:text="아니오"
                android:gravity="center"
                android:background="@drawable/rounded_button"
                android:backgroundTint="@color/color_background"
                android:textColor="@color/black"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 복용 주기 선택 -->
    <LinearLayout
        android:id="@+id/layoutMedicineSchedule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="복용 주기를 선택해주세요"
            android:textSize="20sp"
            android:textAlignment="center"
            android:fontFamily="@font/pretendard_medium"/>

        <!-- 요일 선택 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/mon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="월"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
            <TextView
                android:id="@+id/tue"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="화"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
            <TextView
                android:id="@+id/wed"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="수"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
            <TextView
                android:id="@+id/thu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="목"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
            <TextView
                android:id="@+id/fri"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="금"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
            <TextView
                android:id="@+id/sat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="토"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
            <TextView
                android:id="@+id/sun"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="일"
                android:gravity="center"
                android:background="@drawable/day_unselected"
                android:layout_margin="4dp"/>
        </LinearLayout>

        <!-- 시간 선택 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/layoutMedicineSchedule"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- morning -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="아침"
                    android:textSize="16sp"/>

                <NumberPicker
                    android:id="@+id/morning_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:theme="@style/NumberPickerStyle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시"
                    android:layout_marginHorizontal="4dp"/>

                <NumberPicker
                    android:id="@+id/morning_min"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:theme="@style/NumberPickerStyle" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분"/>
            </LinearLayout>

            <!-- lunch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="점심"
                    android:textSize="16sp"/>

                <NumberPicker
                    android:id="@+id/lunch_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:theme="@style/NumberPickerStyle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시"
                    android:layout_marginHorizontal="4dp"/>

                <NumberPicker
                    android:id="@+id/lunch_min"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:theme="@style/NumberPickerStyle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분"/>
            </LinearLayout>

            <!-- dinner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="저녁"
                    android:textSize="16sp"/>

                <NumberPicker
                    android:id="@+id/dinner_hour"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:theme="@style/NumberPickerStyle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="시"
                    android:layout_marginHorizontal="4dp"/>

                <NumberPicker
                    android:id="@+id/dinner_min"
                    android:layout_width="wrap_content"
                    android:layout_height="80dp"
                    android:theme="@style/NumberPickerStyle"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="분"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>


    <!-- 알림 확인 화면 -->
    <LinearLayout
        android:id="@+id/layoutNotificationConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_marginTop="50dp"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="약 복용 시간에 맞춰\n알림을 보내드릴게요!"
            android:textSize="24sp"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/pretendard_bold"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutBMI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/combined_icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_bmi_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/BMI_normal"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/pretendard_medium"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="차근차근 할 수 있는 운동을\n 추천해드릴게요."
            android:padding="15dp"
            android:textSize="20sp"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:lineSpacingExtra="8sp"
            android:fontFamily="@font/pretendard_medium"/>

        <LinearLayout
            android:id="@+id/bmi_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:gravity="center"
            android:background="@color/color_background">
            <TextView
                android:id="@+id/bmi_box_height"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="키\n___cm"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/pretendard_medium"/>
            <TextView
                android:id="@+id/bmi_box_weight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="몸무게\n__kg"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/pretendard_medium"/>
            <TextView
                android:id="@+id/bmi_box_bmi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="체질량지수\n__.__"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="@font/pretendard_medium"/>
        </LinearLayout>

    </LinearLayout>


    <!-- 다음 버튼 -->
    <TextView
    android:id="@+id/tvNext"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:text="다음"
    android:textSize="24sp"
    android:textColor="@color/white"
    android:fontFamily="@font/pretendard_medium"
    android:background="@drawable/round_corner_primary"
    android:backgroundTint="@color/color_primary"
    android:gravity="center"
    android:layout_marginBottom="40dp"
    app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
