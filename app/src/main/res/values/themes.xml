<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Msmg" parent="Theme.MaterialComponents.Light.NoActionBar" />

    <style name="Theme.EditProfileFragment" parent="Theme.MaterialComponents.Light" />

    <style name="Widget.EditProfile.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="android:textColor">#606060</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Theme.Msmg.AppWidgetContainerParent" parent="@android:style/Theme.DeviceDefault">
        <!-- Radius of the outer bound of widgets to make the rounded corners -->
        <item name="appWidgetRadius">16dp</item>
        <!--
        Radius of the inner view's bound of widgets to make the rounded corners.
        It needs to be 8dp or less than the value of appWidgetRadius
        -->
        <item name="appWidgetInnerRadius">8dp</item>
    </style>

    <style name="Theme.Msmg.AppWidgetContainer" parent="Theme.Msmg.AppWidgetContainerParent">
        <!-- Apply padding to avoid the content of the widget colliding with the rounded corners -->
        <item name="appWidgetPadding">16dp</item>
    </style>

    <style name="SplashTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_icon</item>
        <item name="android:statusBarColor">@color/transparent</item>
    </style>
</resources>